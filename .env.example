# Environment configuration.
# Copy this file to `.env.local` and fill in values. Never commit real secrets.

# ─── Public variables (NEXT_PUBLIC_*) ─────────────────────────────────────
# These are safe to use in the browser and are inlined into the client bundle
# at build time. Never put secrets in any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Server-only variables (secrets) ──────────────────────────────────────
# These are only read on the server and are never exposed to the browser.

# Supabase (required)
SUPABASE_SERVICE_ROLE_KEY=

# LinkedIn API (Phase 3G — OAuth account connection; server-only)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# HMAC secret used to sign OAuth state tokens (CSRF protection). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINKEDIN_OAUTH_STATE_SECRET=

# Scheduler (Phase 3G-C — automated publishing; server-only)
# Secret token for authenticating the GitHub Actions cron job.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHEDULER_SECRET=

# AI provider (Phase 3A/3F — server-only)
# "gemini" enables real generation with automatic template fallback on failure.
# Omit or leave empty to use the built-in template provider ($0 cost).
AI_TEXT_PROVIDER=gemini
AI_IMAGE_PROVIDER=branded-svg
GEMINI_API_KEY=

# Course PDF ingestion (Phase 3I — server-only)
# Maximum accepted PDF upload size in MB (1–100; default 10).
MAX_PDF_SIZE_MB=10

# Automation (introduced later; server-only)
# AUTOMATION_SECRET=

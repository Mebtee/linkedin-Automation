# Environment configuration.
# Copy this file to `.env.local` and fill in values. Never commit real secrets.

# No environment variables are required in the current phase.

# Supabase (introduced in a later phase)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# LinkedIn API (introduced in a later phase)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=

# AI provider (introduced in a later phase)
# AI_API_KEY=
